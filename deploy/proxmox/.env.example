# Public URL used by Securo for CORS, OAuth callbacks, and passkeys.
FRONTEND_URL=https://securo.example.com
SECURO_SITE_ADDRESS=securo.example.com

# Keep application ports private; Caddy is the only LAN-facing service.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Generate independent hexadecimal values so they are safe inside DATABASE_URL:
#   openssl rand -hex 32
POSTGRES_USER=securo
POSTGRES_DB=securo
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql+asyncpg://securo:replace-with-the-same-random-hex@db:5432/securo
SECRET_KEY=replace-with-a-different-random-hex

# Optional bank provider credentials.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_OAUTH_REDIRECT_URI=https://securo.example.com/oauth/callback

# Keep optional agents disabled until the base deployment is verified.
AGENTS_ENABLED=false
AGENTS_MCP_JWT_SECRET=replace-with-another-random-hex

# Daily backup destination mounted from TrueNAS in the VM.
SECURO_BACKUP_DIR=/mnt/securo-backups
